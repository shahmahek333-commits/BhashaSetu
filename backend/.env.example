# ==============================================================================
# BhashaSetu Backend Environment Configuration (.env.example)
# ==============================================================================
# Instructions:
# Copy this file to .env and fill in real values.
# NEVER commit .env with real credentials to source control.
# ==============================================================================

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=*

# Government of India BHASHINI (ULCA / Dhruva) API Credentials
# Obtain these credentials from https://bhashini.gov.in / ULCA developer portal.
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_PIPELINE_ID=your_pipeline_id_here
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# Service Timeouts (in seconds)
BHASHINI_REQUEST_TIMEOUT=15.0
